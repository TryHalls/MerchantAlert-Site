{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "merchantalert-site",
  "main": "./src/site-worker.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}

